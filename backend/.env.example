# ===========================
# SONA AI Environment Variables
# ===========================

# ---- LLM Providers ----
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...

# LLM Configuration
DEFAULT_LLM_PROVIDER=openai  # openai | groq
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Opik ----
OPIK_API_KEY=your_opik_api_key
OPIK_WORKSPACE=sona-ai
OPIK_PROJECT_NAME=sona-evaluation
OPIK_URL=https://www.comet.com/opik

# ---- Vector Database (Pinecone) ----
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=sona-embeddings
PINECONE_DIMENSION=1536  # OpenAI ada-002 dimension

# ---- Database ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/sona
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sona

# ---- Redis (Optional - for caching) ----
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ---- Voice Services ----
# Speech-to-Text
WHISPER_MODEL=base  # tiny | base | small | medium | large
WHISPER_DEVICE=cpu  # cpu | cuda

# Text-to-Speech
TTS_ENGINE=piper  # piper | coqui | openai
TTS_MODEL=en_US-lessac-medium
TTS_SPEED=1.0

# OpenAI Voice (if using)
OPENAI_TTS_VOICE=alloy  # alloy | echo | fable | onyx | nova | shimmer

# ---- Content Extraction ----
# YouTube
YOUTUBE_API_KEY=  # Optional, for metadata

# Web Scraping
USER_AGENT=Mozilla/5.0 (SONA AI Bot)
SCRAPING_TIMEOUT=30

# ---- Application Settings ----
APP_NAME=SONA AI
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ---- Session Configuration ----
# Understanding score thresholds
MIN_QUESTIONS=3
MAX_QUESTIONS=15
CONFIDENCE_THRESHOLD=0.85  # Stop when this confident

# ---- Guardrails ----
GUARDRAILS_ENABLED=true
TOXIC_THRESHOLD=0.7
JAILBREAK_DETECTION=true

# ---- File Upload ----
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=pdf,txt,doc,docx

# ---- MCP Servers ----
MCP_ENABLED=false
MCP_SERVER_PORT=3001

# ---- Development ----
TESTING=false
MOCK_LLM=false
